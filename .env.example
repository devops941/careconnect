# ==============================================================================
# CareConnect - Environment Configuration Template
# ==============================================================================

# MongoDB Connection String (Replica Set recommended for multi-document transactions)
MONGODB_URI="mongodb://localhost:27017/careconnect"

# Application Base URL (used for redirects, verification links, and password resets)
APP_URL="http://localhost:3000"

# Auth.js / NextAuth Session Secret (minimum 32-character random string)
# Generate via: openssl rand -base64 32
AUTH_SECRET="your-32-character-or-longer-random-secret-for-jwt-and-cookie-signing"

# Google OAuth Credentials (From Google Cloud Console: APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Initial Super Admin Bootstrap Credentials (Used strictly by npm run bootstrap:super-admin)
SUPER_ADMIN_NAME="Chief System Administrator"
SUPER_ADMIN_EMAIL="superadmin@careconnect.health"
SUPER_ADMIN_INITIAL_PASSWORD="CareConnect#SuperAdmin2026!"

# Email Service Configuration
# Options: "console" (for development/testing), "resend" (production Resend API)
EMAIL_PROVIDER="console"
EMAIL_FROM="CareConnect Identity <noreply@careconnect.health>"
RESEND_API_KEY=""

# Security & Rate Limiting Settings
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
